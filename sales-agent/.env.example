# ---------------------------------------------------------------------------
# Sales Agent — environment configuration
# Copy to .env and fill in. Nothing here is ever exposed to the browser and
# no credential from this file is ever included in an LLM request.
# ---------------------------------------------------------------------------

# PostgreSQL connection string (required)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sales_agent?schema=public"

# --- LLM -------------------------------------------------------------------
# Provider: ollama | openai-compatible
LLM_PROVIDER=ollama
# Local Ollama (default provider)
OLLAMA_BASE_URL=http://localhost:11434
# Model is NOT hardcoded anywhere in the codebase. Set the tag you pulled.
OLLAMA_MODEL=qwen3
# OpenAI-compatible endpoint (OpenAI, Mistral, OpenRouter, vLLM, LM Studio, ...)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Seconds before an LLM call is aborted
LLM_TIMEOUT_SECONDS=180

# --- Outbound email (SMTP) -------------------------------------------------
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=
SMTP_FROM_EMAIL=

# --- Inbound email (IMAP reply monitor) ------------------------------------
IMAP_HOST=
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=
IMAP_PASSWORD=
IMAP_MAILBOX=INBOX

# --- Application -----------------------------------------------------------
APP_URL=http://localhost:3100
# Shared secret required by POST /api/jobs/tick and /api/imap/sync when set.
# Strongly recommended in production so only your scheduler can run the agent.
JOB_RUNNER_TOKEN=

# --- Search provider -------------------------------------------------------
# none | serper | brave | google_cse
SEARCH_PROVIDER=none
SEARCH_API_KEY=
# Only for google_cse
SEARCH_ENGINE_ID=

# --- Email verification provider -------------------------------------------
# none | hunter | mailboxlayer
EMAIL_VERIFICATION_PROVIDER=none
EMAIL_VERIFICATION_API_KEY=

# --- Contact enrichment provider -------------------------------------------
# none | hunter | apollo
ENRICHMENT_PROVIDER=none
ENRICHMENT_API_KEY=

# --- Sending limits / scheduling -------------------------------------------
GLOBAL_DAILY_EMAIL_LIMIT=100
WORKING_HOURS_START=9
WORKING_HOURS_END=17
TIMEZONE=Europe/Bratislava
# Minimum / maximum minutes between two automatic sends
SEND_MIN_GAP_MINUTES=4
SEND_MAX_GAP_MINUTES=14

# --- Crawler politeness ----------------------------------------------------
CRAWLER_USER_AGENT="SalesAgentBot/0.1 (+https://example.com/bot)"
CRAWLER_TIMEOUT_SECONDS=20
CRAWLER_MAX_PAGES_PER_COMPANY=6
