# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
STRIPE_PRICE_ID=price_your_subscription_price_id

# OpenAI Configuration
OPENAI_API_KEY=sk-your_openai_api_key

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://dreamvaultai.online

# Notes:
# - NEXT_PUBLIC_* variables are exposed to the browser
# - Other variables are server-side only
# - Never commit this file with real values
# - For local development, use http://localhost:3000 for NEXT_PUBLIC_SITE_URL
# - For production on Vercel, use your custom domain

